<?php

/**
 * @file
 * Hybrid navigation: editor-curated parents with auto-populated children.
 *
 * Menu Autopilot lets an editor mark any menu link as a "dynamic parent" whose
 * children are generated from published content (a taxonomy term's members, a
 * content type, or a hand-picked list) and kept in sync automatically. The
 * generated child links are ordinary menu_link_content entities pointing at
 * canonical `entity:node/<nid>` URIs, so every menu consumer — GraphQL,
 * JSON:API, a Twig theme — sees a single, coherent tree with no special work.
 *
 * The per-link configuration and the managed-child bookkeeping are stored in an
 * internal `menu_autopilot` map base field on menu_link_content (see
 * menu_autopilot.install). A boolean `menu_autopilot_dynamic` marker indexes
 * parents with a non-none source so discovery does not hydrate every link.
 * The heavy lifting lives in NavSourceResolver and NavSyncManager.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\menu_autopilot\Form\MenuLinkAutopilotForm;
use Drupal\menu_link_content\MenuLinkContentInterface;
use Drupal\node\NodeInterface;
use Drupal\system\Entity\Menu;

/**
 * Implements hook_help().
 */
function menu_autopilot_help(string $route_name, RouteMatchInterface $route_match): ?string {
  if ($route_name === 'help.page.menu_autopilot') {
    $output = '';
    $output .= '<h2>' . t('About') . '</h2>';
    $output .= '<p>' . t('Menu Autopilot brings hybrid navigation to Drupal: editors curate the top level of a menu by hand, while the children of chosen parents are generated from published content and kept in sync automatically. It is to navigation what Pathauto is to URL aliases.') . '</p>';
    $output .= '<h2>' . t('Choosing which menus are managed') . '</h2>';
    $output .= '<p>' . t('On the <a href=":settings">Menu Autopilot settings</a> page, enable the menus that may have automatic children (the main menu is enabled by default) and set the default sort and limit for new dynamic parents.', [':settings' => Url::fromRoute('menu_autopilot.settings_form')->toString()]) . '</p>';
    $output .= '<h2>' . t('Marking a parent dynamic') . '</h2>';
    $output .= '<p>' . t('Edit any link that is not an automatic child and open the <em>Menu Autopilot</em> section (labelled “Menu Autopilot: children of …” for that item). Pick a source: a taxonomy term (all nodes whose reference field points at it), a content type, or a hand-picked list of nodes. Choose what to do with children that are already there: reuse matching links (optionally removing extras), add only the missing ones, or replace every child. An optional checkbox moves matching unmanaged links from elsewhere in the same menu under this parent. Generated children are then created, reordered, renamed, and removed as content is published, updated, and unpublished.') . '</p>';
    $output .= '<p>' . t('To keep a drag-and-drop order, set <em>Sort children by</em> to “Keep current order”. To include a subtitle or other field in the label, set <em>Child menu label</em> on that same parent (for example <code>[node:title] [node:field_subtitle]</code>). Those controls live on the parent link, not on the menu overview.') . '</p>';
    $output .= '<h2>' . t('Clean URLs') . '</h2>';
    $output .= '<p>' . t('Generated links always store a canonical <code>entity:node/&lt;id&gt;</code> URI, which resolves to the node’s real path alias. They never leak an editorial route such as <code>/node/12/latest</code>.') . '</p>';
    return $output;
  }
  return NULL;
}

/**
 * Implements hook_entity_base_field_info().
 *
 * Adds the internal Autopilot fields to every menu_link_content entity.
 *
 * The `menu_autopilot` map holds the source descriptor on a dynamic parent
 * and `['managed' => TRUE, 'node' => <nid>]` on a generated child.
 * `menu_autopilot_dynamic` is a queryable boolean for parents whose source
 * is not `none`. menu_link_content is a content entity and does not support
 * third-party settings, so base fields are the correct home; they are
 * installed by menu_autopilot_install() via the entity definition update
 * manager.
 */
function menu_autopilot_entity_base_field_info(EntityTypeInterface $entity_type): array {
  if ($entity_type->id() === 'menu_link_content') {
    return [
      'menu_autopilot' => _menu_autopilot_base_field(),
      'menu_autopilot_dynamic' => _menu_autopilot_dynamic_field(),
    ];
  }
  return [];
}

/**
 * Implements hook_entity_field_access().
 *
 * The two Autopilot fields on menu links are written only by this module: the
 * menu link form's entity builder, the sync manager and the Drush and MCP
 * commands that call it. Those set the values in code, which field access does
 * not govern. Everything that does consult field access is an outside writer
 * or reader (JSON:API, core REST, a form widget, a formatter), and none of
 * them has a reason to touch these fields.
 *
 * The internal flag on the definitions only keeps the fields out of
 * normalized output. It does not stop a write: JSON:API and REST both accept
 * an internal field in a PATCH from any account that may update the link. A
 * stored map can mark a link as a managed child, or as a dynamic parent whose
 * next sync deletes its other children, without the checks the form applies.
 *
 * Every operation is forbidden, for every account, including user 1.
 * Forbidden outranks another module's neutral or allowed result. Only a
 * hook_entity_field_access_alter() implementation that removes this module's
 * result could reopen the fields.
 */
function menu_autopilot_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResultInterface {
  if ($field_definition->getTargetEntityTypeId() !== 'menu_link_content') {
    return AccessResult::neutral();
  }
  if (!in_array($field_definition->getName(), ['menu_autopilot', 'menu_autopilot_dynamic'], TRUE)) {
    return AccessResult::neutral();
  }
  return AccessResult::forbidden('The Menu Autopilot fields are module-owned. They are written only by Menu Autopilot and are not readable or writable through field access.');
}

/**
 * Builds the shared definition of the `menu_autopilot` base field.
 *
 * Used by both hook_entity_base_field_info() and the install hook so the two
 * can never drift.
 *
 * @return \Drupal\Core\Field\BaseFieldDefinition
 *   The field definition.
 */
function _menu_autopilot_base_field() {
  return BaseFieldDefinition::create('map')
    ->setLabel(t('Menu Autopilot'))
    ->setDescription(t('Dynamic-children source descriptor (on parents) and managed-child metadata (on generated links).'))
    // Internal plumbing: keep it out of JSON:API, REST, and GraphQL output.
    ->setInternal(TRUE)
    ->setDisplayConfigurable('form', FALSE)
    ->setDisplayConfigurable('view', FALSE);
}

/**
 * Builds the shared definition of the dynamic-parent marker field.
 *
 * Queryable boolean kept in sync with the map by hook_entity_presave().
 *
 * @return \Drupal\Core\Field\BaseFieldDefinition
 *   The field definition.
 */
function _menu_autopilot_dynamic_field() {
  return BaseFieldDefinition::create('boolean')
    ->setLabel(t('Menu Autopilot dynamic parent'))
    ->setDescription(t('Queryable flag for parents with a non-none Autopilot source. The map field remains the descriptor.'))
    ->setDefaultValue(FALSE)
    ->setInternal(TRUE)
    ->setDisplayConfigurable('form', FALSE)
    ->setDisplayConfigurable('view', FALSE);
}

/**
 * Implements hook_entity_presave().
 */
function menu_autopilot_entity_presave(EntityInterface $entity): void {
  if (!$entity instanceof MenuLinkContentInterface) {
    return;
  }
  if ($entity->hasField('menu_autopilot_dynamic')) {
    $data = _menu_autopilot_link_data($entity);
    $dynamic = empty($data['managed']) && (($data['source']['type'] ?? 'none') !== 'none');
    $entity->set('menu_autopilot_dynamic', $dynamic);
  }
  /** @var \Drupal\menu_autopilot\NavSyncManager $sync */
  $sync = \Drupal::service('menu_autopilot.sync_manager');
  $sync->flagManagedIfParentMoving($entity);
  $sync->clearStaleDisabledBySaveFlag($entity);
}

/**
 * Implements hook_entity_insert().
 */
function menu_autopilot_entity_insert(EntityInterface $entity): void {
  _menu_autopilot_react($entity);
}

/**
 * Implements hook_entity_update().
 */
function menu_autopilot_entity_update(EntityInterface $entity): void {
  _menu_autopilot_react($entity);
}

/**
 * Implements hook_entity_predelete().
 *
 * Runs while the parent is still queryable. hook_entity_delete is too late:
 * children are looked up by the parent's uuid and menu name.
 */
function menu_autopilot_entity_predelete(EntityInterface $entity): void {
  if ($entity instanceof MenuLinkContentInterface) {
    /** @var \Drupal\menu_autopilot\NavSyncManager $sync */
    $sync = \Drupal::service('menu_autopilot.sync_manager');
    $sync->onParentDeleted($entity);
  }
}

/**
 * Implements hook_entity_delete().
 */
function menu_autopilot_entity_delete(EntityInterface $entity): void {
  // A deleted node is already gone from storage, so re-syncing any parent that
  // owned a link for it drops that link.
  if ($entity instanceof NodeInterface) {
    _menu_autopilot_react($entity);
  }
}

/**
 * Routes a saved or deleted entity to the sync manager.
 *
 * Node changes reconcile every dynamic parent the node can affect; menu-link
 * changes reconcile that link's own children when it is a dynamic parent. The
 * sync manager's re-entrancy guard means the child links it writes here do not
 * trigger a second, nested reconcile.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity that was just saved or deleted.
 */
function _menu_autopilot_react(EntityInterface $entity): void {
  /** @var \Drupal\menu_autopilot\NavSyncManager $sync */
  $sync = \Drupal::service('menu_autopilot.sync_manager');
  if ($sync->isSyncing()) {
    return;
  }
  if ($entity instanceof NodeInterface) {
    // Node forms save the entity before menu_ui's submit handler runs. Queue
    // until that handler has finished so we do not delete a link it still
    // holds by entity id.
    if (_menu_autopilot_should_defer_node_sync()) {
      $sync->queueNode($entity);
      return;
    }
    $sync->syncNode($entity);
  }
  elseif ($entity instanceof MenuLinkContentInterface) {
    $sync->releaseOwnedChildrenIfSourceCleared($entity);
    $sync->syncParentIfDynamic($entity);
  }
}

/**
 * TRUE while a node form submit is in progress.
 */
function _menu_autopilot_should_defer_node_sync(): bool {
  return (bool) \Drupal::request()->attributes->get('_menu_autopilot_defer_node_sync');
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 *
 * This alter runs before menu_ui (alphabetical). The work that needs
 * $form['menu'] and a flush submit after menu_ui's handler is done in
 * #after_build, which runs once the form is fully built.
 */
function menu_autopilot_form_node_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  \Drupal::request()->attributes->set('_menu_autopilot_defer_node_sync', TRUE);
  $form['#after_build'][] = '_menu_autopilot_node_form_after_build';
}

/**
 * After-build: hide menu_ui's widget on automatic children and flush last.
 *
 * Menu UI treats the first menu_link_content pointing at the node as that
 * node's own "Provide a menu link" item. When that link is an automatic
 * child, writing it on node save creates pending menu-link revisions and
 * archiving fatals after this module has already deleted the child.
 */
function _menu_autopilot_node_form_after_build(array $form, FormStateInterface $form_state): array {
  foreach (array_keys($form['actions'] ?? []) as $action) {
    if ($action === 'preview') {
      continue;
    }
    if (($form['actions'][$action]['#type'] ?? '') !== 'submit') {
      continue;
    }
    $submit = $form['actions'][$action]['#submit'] ?? [];
    if (!in_array('_menu_autopilot_flush_queued_node_sync', $submit, TRUE)) {
      $submit[] = '_menu_autopilot_flush_queued_node_sync';
      $form['actions'][$action]['#submit'] = $submit;
    }
  }

  $entity_id = $form['menu']['link']['entity_id']['#value'] ?? NULL;
  if (!$entity_id) {
    return $form;
  }
  $link = \Drupal::entityTypeManager()->getStorage('menu_link_content')->load($entity_id);
  if (!$link instanceof MenuLinkContentInterface) {
    return $form;
  }
  if (empty(_menu_autopilot_link_data($link)['managed'])) {
    return $form;
  }

  // Hide menu_ui's widget so editors do not treat this as the node's own
  // link. #after_build is too late to stop input processing: an unrendered
  // checkbox arrives as enabled=0, weight/parent drop to the empty defaults,
  // and a pending revision then fails MenuSettingsConstraint. Restore the
  // live link and do not let menu_ui write it.
  //
  // Stamp #parents on the notice. This element is injected after processing,
  // so FormErrorHandler's getError() walk would otherwise warn
  // "Undefined array key #parents" whenever any other field fails validation.
  $form['menu']['#access'] = FALSE;
  $form['menu_autopilot_owned'] = [
    '#type' => 'item',
    '#title' => t('Menu link'),
    '#markup' => t('This page appears in the menu as an automatic child. To change its label or order, edit the parent menu item and open its <em>Menu Autopilot</em> section.'),
    '#weight' => -2,
    '#group' => 'advanced',
    '#parents' => ['menu_autopilot_owned'],
    '#array_parents' => ['menu_autopilot_owned'],
  ];

  $values = $form_state->getValue('menu');
  if (!is_array($values)) {
    $values = [];
  }
  $values['enabled'] = 1;
  $values['entity_id'] = $entity_id;
  $values['title'] = $link->getTitle();
  $values['description'] = (string) $link->getDescription();
  $values['weight'] = (int) $link->getWeight();
  $values['menu_name'] = $link->getMenuName();
  $values['parent'] = $link->getParentId();
  $values['menu_parent'] = $link->getMenuName() . ':' . $link->getParentId();
  $form_state->setValue('menu', $values);

  foreach (array_keys($form['actions'] ?? []) as $action) {
    if (($form['actions'][$action]['#type'] ?? '') !== 'submit') {
      continue;
    }
    $submit = $form['actions'][$action]['#submit'] ?? [];
    $form['actions'][$action]['#submit'] = array_values(array_filter(
      $submit,
      static fn ($handler): bool => !_menu_autopilot_is_menu_ui_node_submit($handler),
    ));
  }

  return $form;
}

/**
 * Whether a submit handler is menu_ui's node-form writer.
 */
function _menu_autopilot_is_menu_ui_node_submit(mixed $handler): bool {
  return $handler === 'menu_ui_form_node_form_submit'
    || $handler === 'Drupal\menu_ui\Hook\MenuUiHooks:formNodeFormSubmit';
}

/**
 * Submit handler: reconcile nodes queued during this form save.
 */
function _menu_autopilot_flush_queued_node_sync(array &$form, FormStateInterface $form_state): void {
  \Drupal::service('menu_autopilot.sync_manager')->flushQueued();
}

/**
 * Implements hook_form_FORM_ID_alter() for menu_edit_form.
 *
 * The overview is where editors try to rename and drag automatic children,
 * so say here how labels and order are actually controlled.
 */
function menu_autopilot_form_menu_edit_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form_object = $form_state->getFormObject();
  $menu = $form_object instanceof EntityFormInterface ? $form_object->getEntity() : NULL;
  if (!$menu instanceof Menu) {
    return;
  }
  $managed = \Drupal::service('menu_autopilot.status_reporter')->managedMenus();
  if (!in_array($menu->id(), $managed, TRUE)) {
    return;
  }
  $form['menu_autopilot_overview_help'] = [
    '#type' => 'item',
    '#weight' => -20,
    '#markup' => '<p>' . t('Menu Autopilot keeps automatic children in sync with published content. To keep a drag-and-drop order or set a label pattern, edit the <em>parent</em> link and open its <em>Menu Autopilot</em> section (for example “Menu Autopilot: children of Platforms”). Use <em>Sort children by</em> → “Keep current order”, and <em>Child menu label</em> such as <code>[node:title] [node:field_subtitle]</code>.') . '</p>',
  ];
}

/**
 * The parent-link form helper.
 *
 * Alter, validate, builders, and option lists live on
 * MenuLinkAutopilotForm. These wrappers keep the hook and Form API
 * callback names the tests and #entity_builders arrays already use.
 * #[Hook] conversion is a separate change: the node-form alter must
 * still run before menu_ui alphabetically.
 *
 * @return \Drupal\menu_autopilot\Form\MenuLinkAutopilotForm
 *   A helper built from the current container.
 */
function _menu_autopilot_link_form(): MenuLinkAutopilotForm {
  return MenuLinkAutopilotForm::create(\Drupal::getContainer());
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for menu_link_content_form.
 *
 * Adds a "Menu Autopilot" section to the menu link form so an editor can
 * turn any link into a dynamic parent. The values are persisted onto the
 * link's `menu_autopilot` base field by _menu_autopilot_link_form_builder().
 */
function menu_autopilot_form_menu_link_content_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  _menu_autopilot_link_form()->alterLinkForm($form, $form_state);
}

/**
 * Entity builder for an automatic child that a sync save left disabled.
 *
 * Form API looks this name up from #entity_builders. $entity_type_id
 * and $form are the builder signature; the body does not read them.
 *
 * @param string $entity_type_id
 *   The entity type id ('menu_link_content').
 * @param \Drupal\menu_link_content\MenuLinkContentInterface $link
 *   The menu link being built.
 * @param array $form
 *   The complete form array.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The current form state.
 */
function _menu_autopilot_managed_link_form_builder(string $entity_type_id, MenuLinkContentInterface $link, array &$form, FormStateInterface $form_state): void {
  _menu_autopilot_link_form()->buildManagedLink($link, $form_state);
}

/**
 * Validation handler: enforces the fields each source type needs.
 *
 * Form API looks this name up from #validate.
 *
 * @param array $form
 *   The complete form array.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The current form state.
 */
function _menu_autopilot_link_form_validate(array &$form, FormStateInterface $form_state): void {
  _menu_autopilot_link_form()->validateLinkForm($form, $form_state);
}

/**
 * Entity builder: writes the Menu Autopilot values onto the link.
 *
 * Form API looks this name up from #entity_builders. $entity_type_id
 * and $form are the builder signature; the body does not read them.
 *
 * @param string $entity_type_id
 *   The entity type id ('menu_link_content').
 * @param \Drupal\menu_link_content\MenuLinkContentInterface $link
 *   The menu link being built.
 * @param array $form
 *   The complete form array.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The current form state.
 */
function _menu_autopilot_link_form_builder(string $entity_type_id, MenuLinkContentInterface $link, array &$form, FormStateInterface $form_state): void {
  _menu_autopilot_link_form()->buildLink($link, $form_state);
}

/**
 * Reads the `menu_autopilot` map value off a menu link.
 *
 * @param \Drupal\menu_link_content\MenuLinkContentInterface $link
 *   The menu link.
 *
 * @return array
 *   The stored map, or an empty array.
 */
function _menu_autopilot_link_data(MenuLinkContentInterface $link) {
  if (!$link->hasField('menu_autopilot') || $link->get('menu_autopilot')->isEmpty()) {
    return [];
  }
  $value = $link->get('menu_autopilot')->first()->getValue();
  return is_array($value) ? $value : [];
}
