<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="menu_autopilot">
  <description>Drupal coding standards for Menu Autopilot.</description>

  <file>.</file>
  <arg name="extensions" value="php,module,inc,install,test,info.yml,yml"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
