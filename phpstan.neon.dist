# PHPStan configuration for Menu Autopilot.
# GitHub phpstan and local analysis use this file and include the optional
# MCP tools (those runs install Tool API and MCP Sentinel). Drupal.org
# prefers phpstan.neon, which includes this file and excludes
# modules/menu_autopilot_mcp.
includes:
  - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
  level: 6
  # Inline @phpstan-ignore comments may not match across phpstan versions.
  reportUnmatchedIgnoredErrors: false
  paths:
    - .
  excludePaths:
    # Optional (?): there is no vendor/ under the module in DrupalCI, where the
    # module is analysed in place; the marker stops PHPStan erroring when it is absent.
    - vendor (?)
  fileExtensions:
    - php
    - module
    - inc
    - install
  ignoreErrors:
    # new static() is a Drupal best practice for plugins and services.
    - "#^Unsafe usage of new static#"
    - identifier: missingType.iterableValue
    - identifier: missingType.generics
    # PHPStan 2.3, via bleedingEdge, reports hook and form-callback
    # parameters the body does not read. Those names are the API.
    # Class methods are reported as Method, so this stays on the
    # procedural functions.
    -
      identifier: function.unusedParameter
      message: '#^Function _?menu_autopilot_#'
